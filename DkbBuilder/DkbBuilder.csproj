<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DkbBuilder</AssemblyName>
    <RootNamespace>DkbBuilder</RootNamespace>
    <Version>0.1.0</Version>
    <Product>oot-win Builder</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon Condition="Exists('dkb.ico')">dkb.ico</ApplicationIcon>
    <ApplicationIcon>dkb.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Needs nothing installed: dotnet publish -c Release. A folder (the app and .NET's own signed files), not one compressed exe:
       antivirus programs took the self-extracting single file for a trojan and removed it -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Inter (SIL Open Font License, Fonts/Inter-LICENSE.txt) and the hookshot, inside the app -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Images\dkb.png" />
    <None Include="Fonts\Inter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup><Resource Include="dkb.ico" /></ItemGroup>
</Project>
